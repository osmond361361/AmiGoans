# Copy this file to .env and fill in real values. Never commit .env.

# development | production | testing
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://amigoans:amigoans@localhost:5432/amigoans

# OAuth "Sign in with Google/Facebook" credentials.
# Leave unset to keep those buttons showing a "not yet configured" page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Outgoing email (password reset, etc.) via Gmail SMTP.
# MAIL_USERNAME is the full Gmail address; MAIL_PASSWORD is a 16-character
# Gmail "App Password" (myaccount.google.com/apppasswords), NOT the normal
# account password -- App Passwords require 2-Step Verification to be on.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=amigoans2026@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Ami Goans <amigoans2026@gmail.com>
